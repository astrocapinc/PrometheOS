{
  "name": "prometheos-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "PrometheOS desktop application: the loopback hub in a window, the core as a sidecar (CP19.2, decision 0054).",
  "main": "main.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.prometheos.desktop",
    "productName": "PrometheOS",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "build/core",
        "to": "core"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "build/notices/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "shortcutName": "PrometheOS"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
