{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed change impact and historical acceptance carry-forward",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "from_manifest",
    "from_tree_sha256",
    "to_manifest",
    "to_tree_sha256",
    "changed_paths",
    "affected_check_ids",
    "rerun_receipts",
    "carried_checks",
    "author_id",
    "reviewer_id",
    "review_status",
    "review_evidence_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "from_manifest": {
      "type": "string",
      "minLength": 1
    },
    "from_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "to_manifest": {
      "type": "string",
      "minLength": 1
    },
    "to_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_check_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rerun_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "carried_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_receipt",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_receipt": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "author_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "pending",
        "changes_requested",
        "accepted"
      ]
    },
    "review_evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
