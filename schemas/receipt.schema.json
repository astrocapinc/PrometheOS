{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheos.local/schemas/receipt.schema.json",
  "title": "PrometheOS development checkpoint receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "spec_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^CP(?:[0-9]|1[0-9]|2[0-2])$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tree_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "git_revision",
        "tree_sha256",
        "tree_manifest_path",
        "dirty"
      ]
    },
    "implementer_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "tool_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version"
            ]
          }
        }
      },
      "required": [
        "os",
        "architecture",
        "python",
        "tool_versions"
      ]
    },
    "technical_status": {
      "enum": [
        "in_progress",
        "failed",
        "passed"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_run",
              "blocked_external",
              "failed",
              "passed",
              "not_applicable"
            ]
          },
          "method": {
            "enum": [
              "automated",
              "manual",
              "live",
              "field"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "evidence_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "command",
                "exit_code",
                "evidence_paths"
              ]
            }
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observer": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "status",
          "method",
          "commands",
          "evidence_paths",
          "observer",
          "summary",
          "limitations"
        ]
      }
    },
    "external_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_run",
              "blocked_external",
              "failed",
              "passed",
              "not_applicable"
            ]
          },
          "method": {
            "enum": [
              "automated",
              "manual",
              "live",
              "field"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "evidence_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "command",
                "exit_code",
                "evidence_paths"
              ]
            }
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observer": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "status",
          "method",
          "commands",
          "evidence_paths",
          "observer",
          "summary",
          "limitations"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "description"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "changes_requested",
            "accepted"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewer_id",
        "evidence_paths",
        "summary"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_task": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "spec_version",
    "spec_manifest_sha256",
    "run_id",
    "checkpoint_id",
    "created_at",
    "candidate",
    "implementer_id",
    "environment",
    "technical_status",
    "checks",
    "external_checks",
    "evidence",
    "review",
    "limitations",
    "next_task"
  ]
}
