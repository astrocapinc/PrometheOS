{
  "$defs": {
    "AudioLocator": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "start_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "type": {
          "const": "audio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start_ms",
        "end_ms"
      ],
      "title": "AudioLocator",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "discriminator": {
            "mapping": {
              "audio": "#/$defs/AudioLocator",
              "file": "#/$defs/FileLocator",
              "json": "#/$defs/JsonLocator",
              "pdf": "#/$defs/PdfLocator",
              "text": "#/$defs/TextLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextLocator"
            },
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/AudioLocator"
            },
            {
              "$ref": "#/$defs/JsonLocator"
            },
            {
              "$ref": "#/$defs/FileLocator"
            }
          ],
          "title": "Locator"
        },
        "quote_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Sha256"
        },
        "source_id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Source Id",
          "type": "string"
        },
        "version_id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version_id",
        "locator",
        "quote_sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FileLocator": {
      "additionalProperties": false,
      "description": "A whole artefact, bound by its version digest (A06.1, CP20.1): for binary artefacts such\nas ``.mat``, ``.slx`` or ``.png`` that have no lines, pages or pointers. It carries no quote\nand binds no quantity.",
      "properties": {
        "type": {
          "const": "file",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FileLocator",
      "type": "object"
    },
    "JsonLocator": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 1024,
          "pattern": "^(/([^~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "type": {
          "const": "json",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pointer"
      ],
      "title": "JsonLocator",
      "type": "object"
    },
    "MatrixCell": {
      "additionalProperties": false,
      "description": "One cell: a value with the evidence it is quoted from, how it was found, and its review\nstate. A cell without evidence can only be unsupported (C11-GROUNDING); quantities follow\nthe binding rules and cite one of the cell's evidence references.",
      "properties": {
        "basis": {
          "enum": [
            "full_text",
            "abstract",
            "metadata"
          ],
          "title": "Basis",
          "type": "string"
        },
        "column_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Column Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "method": {
          "enum": [
            "manual",
            "rule",
            "model"
          ],
          "title": "Method",
          "type": "string"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/QuantityBinding"
          },
          "maxItems": 20,
          "title": "Quantities",
          "type": "array"
        },
        "state": {
          "enum": [
            "proposed",
            "reviewed",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        },
        "transformation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transformation"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_text": {
          "maxLength": 4000,
          "title": "Value Text",
          "type": "string"
        }
      },
      "required": [
        "column_id",
        "value_text",
        "quantities",
        "evidence",
        "basis",
        "state",
        "method",
        "transformation"
      ],
      "title": "MatrixCell",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "description": "A page and an optional box. CP11 S11.1 (decision 0060) adds optional ``start``/``end``\ncharacter offsets into the page's extracted text (Unicode code points, end exclusive), so\na quotation is checkable exactly. Additive: a locator without offsets serialises exactly\nas before (no null members), and older records stay valid.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End (exclusive) in the page's extracted text, in Unicode code points",
          "title": "End"
        },
        "page": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First character in the page's extracted text, in Unicode code points",
          "title": "Start"
        },
        "type": {
          "const": "pdf",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "page",
        "bbox"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "QuantityBinding": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "pattern": "^[+-]?(\\d+(\\.\\d+)?|\\.\\d+)([eE][+-]?\\d+)?$",
          "title": "Decimal",
          "type": "string"
        },
        "definition": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "source_pointer": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Pointer",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "unit": {
          "maxLength": 64,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "decimal",
        "unit",
        "source_ref",
        "source_pointer"
      ],
      "title": "QuantityBinding",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "rev": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Rev",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "TextLocator": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_line": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start_line",
        "end_line"
      ],
      "title": "TextLocator",
      "type": "object"
    },
    "Transformation": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "input_version_refs": {
          "items": {
            "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Input Version Refs",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 35,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "parameters_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Digest",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "type": {
          "enum": [
            "extraction",
            "transcription",
            "conversion"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "engine",
        "engine_version",
        "model",
        "language",
        "parameters_digest",
        "input_version_refs",
        "run_id"
      ],
      "title": "Transformation",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/extraction_body.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One matrix row: the cells extracted for one work under one matrix revision.",
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/MatrixCell"
      },
      "maxItems": 50,
      "title": "Cells",
      "type": "array"
    },
    "matrix_ref": {
      "$ref": "#/$defs/RecordRef"
    },
    "work_ref": {
      "$ref": "#/$defs/RecordRef"
    }
  },
  "required": [
    "matrix_ref",
    "work_ref",
    "cells"
  ],
  "title": "ExtractionBody",
  "type": "object"
}
