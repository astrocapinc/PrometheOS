{
  "$defs": {
    "EvidenceObject": {
      "additionalProperties": false,
      "description": "Exactly one of: another inventory path, a literal value, an external identifier, or a\nfacet name with its value.",
      "properties": {
        "external": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External"
        },
        "facet": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Facet"
        },
        "literal": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 32767,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "title": "EvidenceObject",
      "type": "object"
    },
    "JsonValue": {},
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "kind": {
          "enum": [
            "line",
            "byte",
            "part",
            "xml",
            "json_pointer",
            "page_span",
            "member"
          ],
          "title": "Kind",
          "type": "string"
        },
        "part": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/adoption_evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One fact from one analyzer about one inventory row (table ``adoption_evidence``).",
  "properties": {
    "analyzer": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "title": "Analyzer",
      "type": "string"
    },
    "analyzer_version": {
      "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,6}$",
      "title": "Analyzer Version",
      "type": "string"
    },
    "determinism": {
      "enum": [
        "pure",
        "pinned_tool",
        "reported",
        "proposed"
      ],
      "title": "Determinism",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^ev_[0-9a-f]{32}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/Locator"
        },
        {
          "type": "null"
        }
      ]
    },
    "object": {
      "$ref": "#/$defs/EvidenceObject"
    },
    "predicate": {
      "enum": [
        "copy_of",
        "same_origin_as",
        "revision_of",
        "autosave_of",
        "backup_of",
        "cache_of",
        "derived_from",
        "generated_by",
        "used",
        "consumed_by",
        "references",
        "calls",
        "model_reference",
        "library_link",
        "has_status",
        "supersedes",
        "project_file",
        "facet",
        "language",
        "unresolved"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "quote": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quote"
    },
    "quote_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quote Sha256"
    },
    "scan_gen": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Scan Gen",
      "type": "integer"
    },
    "subject": {
      "maxLength": 32767,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "subject_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Subject Sha256"
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "scan_gen",
    "analyzer",
    "analyzer_version",
    "subject",
    "subject_sha256",
    "predicate",
    "object",
    "locator",
    "quote",
    "quote_sha256",
    "tier",
    "determinism"
  ],
  "title": "AdoptionEvidence",
  "type": "object"
}
