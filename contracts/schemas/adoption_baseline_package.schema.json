  "$id": "https://prometheos.local/contracts/adoption_baseline_package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An accepted baseline with its generation and the folder's owner decisions, as\n``adoption_baseline_export`` returns it and ``adoption_baseline_import`` takes it.\n``sha256`` is the SHA-256 of the canonical content without it (checked on import).",
  "properties": {
    "baseline": {
      "$ref": "#/$defs/PackagedBaseline"
    },
    "class_decisions": {
      "items": {
        "$ref": "#/$defs/PackagedClassDecision"
      },
      "maxItems": 100000,
      "title": "Class Decisions",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/PackagedDecision"
      },
      "maxItems": 100000,
      "title": "Decisions",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/AdoptionEvidence"
      },
      "maxItems": 5000000,
      "title": "Evidence",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/AdoptionFile"
      },
      "maxItems": 2000000,
      "title": "Files",
      "type": "array"
    },
    "format": {
      "const": 1,
      "title": "Format",
      "type": "integer"
    },
    "kind": {
      "const": "prometheos-adoption-baseline",
      "title": "Kind",
      "type": "string"
    },
    "scan": {
      "$ref": "#/$defs/AdoptionScan"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "format",
    "baseline",
    "scan",
    "files",
    "evidence",
    "decisions",
    "sha256"
  ],
  "title": "AdoptionBaselinePackage",
  "type": "object"
}
