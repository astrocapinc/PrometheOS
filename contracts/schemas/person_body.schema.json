{
  "$id": "https://prometheos.local/contracts/person_body.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affiliation": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Affiliation"
    },
    "contact": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Contact"
    },
    "display_name": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "notes": {
      "maxLength": 65536,
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "display_name",
    "affiliation",
    "contact",
    "notes"
  ],
  "title": "PersonBody",
  "type": "object"
}
