{
  "$defs": {
    "FamilyConflict": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "pattern": "^ev_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "statement_conflict",
            "contradicted_statement",
            "owner_overrode_exclusion",
            "old_member_in_use"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paths": {
          "items": {
            "maxLength": 32767,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Paths",
          "type": "array"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "evidence",
        "paths"
      ],
      "title": "FamilyConflict",
      "type": "object"
    },
    "FamilyMember": {
      "additionalProperties": false,
      "properties": {
        "copy_of": {
          "anyOf": [
            {
              "maxLength": 32767,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Copy Of"
        },
        "outcome": {
          "enum": [
            "current",
            "candidate",
            "excluded",
            "copy"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "path": {
          "maxLength": 32767,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rank"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/RankReason"
          },
          "maxItems": 50,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "path",
        "outcome",
        "copy_of",
        "rank",
        "reasons"
      ],
      "title": "FamilyMember",
      "type": "object"
    },
    "RankReason": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "pattern": "^ev_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence",
          "type": "array"
        },
        "rule": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R3b",
            "R4",
            "R5",
            "R6",
            "R7",
            "R8"
          ],
          "title": "Rule",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "T5",
            "T6",
            "T7",
            "T8"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "tier",
        "text",
        "evidence"
      ],
      "title": "RankReason",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/adoption_family.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Files that are versions or copies of one thing, ranked (table ``adoption_families``,\ncolumn ``payload``). Ranks are proposals: only an owner decision (R1, T0) or an accepted\nbaseline makes one authoritative.",
  "properties": {
    "band": {
      "enum": [
        "decided",
        "supported",
        "weak",
        "undecided"
      ],
      "title": "Band",
      "type": "string"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/FamilyConflict"
      },
      "maxItems": 200,
      "title": "Conflicts",
      "type": "array"
    },
    "current": {
      "anyOf": [
        {
          "maxLength": 32767,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current"
    },
    "deciding_rule": {
      "anyOf": [
        {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R3b",
            "R4",
            "R5",
            "R6",
            "R7",
            "R8"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Deciding Rule"
    },
    "family_id": {
      "pattern": "^fam_[0-9a-f]{16}$",
      "title": "Family Id",
      "type": "string"
    },
    "key": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "enum": [
        "code",
        "notebook",
        "model",
        "data",
        "document",
        "image",
        "archive",
        "other",
        "mixed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/FamilyMember"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Members",
      "type": "array"
    },
    "scan_gen": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Scan Gen",
      "type": "integer"
    }
  },
  "required": [
    "scan_gen",
    "family_id",
    "key",
    "kind",
    "members",
    "current",
    "band",
    "deciding_rule",
    "conflicts"
  ],
  "title": "AdoptionFamily",
  "type": "object"
}
