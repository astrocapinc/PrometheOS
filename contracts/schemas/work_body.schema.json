{
  "$defs": {
    "AudioLocator": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "start_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "type": {
          "const": "audio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start_ms",
        "end_ms"
      ],
      "title": "AudioLocator",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "discriminator": {
            "mapping": {
              "audio": "#/$defs/AudioLocator",
              "file": "#/$defs/FileLocator",
              "json": "#/$defs/JsonLocator",
              "pdf": "#/$defs/PdfLocator",
              "text": "#/$defs/TextLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextLocator"
            },
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/AudioLocator"
            },
            {
              "$ref": "#/$defs/JsonLocator"
            },
            {
              "$ref": "#/$defs/FileLocator"
            }
          ],
          "title": "Locator"
        },
        "quote_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote Sha256"
        },
        "source_id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Source Id",
          "type": "string"
        },
        "version_id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "version_id",
        "locator",
        "quote_sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FieldProvenance": {
      "additionalProperties": false,
      "description": "Where one field of a work came from: a version and a locator in it. ``basis`` says how\n(decision 0061): the PDF information dictionary (a JSON pointer into the extracted\nversion), a first-page text span (a PDF locator with character offsets), or the file name\n(no locator).",
      "properties": {
        "basis": {
          "enum": [
            "pdf_info",
            "first_page_text",
            "file_name",
            "bibliography",
            "zotero"
          ],
          "title": "Basis",
          "type": "string"
        },
        "entry": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry"
        },
        "field": {
          "enum": [
            "title",
            "contributors",
            "year",
            "venue",
            "identifiers.doi",
            "identifiers.arxiv",
            "identifiers.pmid",
            "identifiers.pmcid",
            "identifiers.isbn",
            "abstract_ref",
            "entry_type"
          ],
          "title": "Field",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "audio": "#/$defs/AudioLocator",
                  "file": "#/$defs/FileLocator",
                  "json": "#/$defs/JsonLocator",
                  "pdf": "#/$defs/PdfLocator",
                  "text": "#/$defs/TextLocator"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextLocator"
                },
                {
                  "$ref": "#/$defs/PdfLocator"
                },
                {
                  "$ref": "#/$defs/AudioLocator"
                },
                {
                  "$ref": "#/$defs/JsonLocator"
                },
                {
                  "$ref": "#/$defs/FileLocator"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Locator"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "version_ref": {
          "$ref": "#/$defs/RecordRef"
        }
      },
      "required": [
        "field",
        "version_ref",
        "locator",
        "basis"
      ],
      "title": "FieldProvenance",
      "type": "object"
    },
    "FileLocator": {
      "additionalProperties": false,
      "description": "A whole artefact, bound by its version digest (A06.1, CP20.1): for binary artefacts such\nas ``.mat``, ``.slx`` or ``.png`` that have no lines, pages or pointers. It carries no quote\nand binds no quantity.",
      "properties": {
        "type": {
          "const": "file",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "FileLocator",
      "type": "object"
    },
    "JsonLocator": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 1024,
          "pattern": "^(/([^~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "type": {
          "const": "json",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pointer"
      ],
      "title": "JsonLocator",
      "type": "object"
    },
    "OtherIdentifier": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Scheme",
          "type": "string"
        },
        "value": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "OtherIdentifier",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "description": "A page and an optional box. CP11 S11.1 (decision 0060) adds optional ``start``/``end``\ncharacter offsets into the page's extracted text (Unicode code points, end exclusive), so\na quotation is checkable exactly. Additive: a locator without offsets serialises exactly\nas before (no null members), and older records stay valid.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bbox"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End (exclusive) in the page's extracted text, in Unicode code points",
          "title": "End"
        },
        "page": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First character in the page's extracted text, in Unicode code points",
          "title": "Start"
        },
        "type": {
          "const": "pdf",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "page",
        "bbox"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "rev": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Rev",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev"
      ],
      "title": "RecordRef",
      "type": "object"
    },
    "TextLocator": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_line": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start_line",
        "end_line"
      ],
      "title": "TextLocator",
      "type": "object"
    },
    "WorkContributor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "author",
            "editor"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "WorkContributor",
      "type": "object"
    },
    "WorkIdentifiers": {
      "additionalProperties": false,
      "properties": {
        "arxiv": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9]{4}\\.[0-9]{4,5}|[a-z][a-z.-]{1,30}/[0-9]{7})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Arxiv"
        },
        "doi": {
          "anyOf": [
            {
              "maxLength": 320,
              "pattern": "^10\\.[0-9]{4,9}/[!-~]{1,300}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doi"
        },
        "isbn": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9]{9}[0-9X]|[0-9]{13})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Isbn"
        },
        "other": {
          "items": {
            "$ref": "#/$defs/OtherIdentifier"
          },
          "maxItems": 100,
          "title": "Other",
          "type": "array"
        },
        "pmcid": {
          "anyOf": [
            {
              "pattern": "^PMC[1-9][0-9]{0,9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pmcid"
        },
        "pmid": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pmid"
        }
      },
      "required": [
        "doi",
        "arxiv",
        "pmid",
        "pmcid",
        "isbn",
        "other"
      ],
      "title": "WorkIdentifiers",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/work_body.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bibliographic work (spec/03, CP11). Imported bytes stay source versions; the work\npoints at the extracted full text and says where each field came from. In S11.1 a work is\nregistered only by the library importer.",
  "properties": {
    "abstract_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "access_state": {
      "enum": [
        "metadata_only",
        "abstract_only",
        "full_text",
        "unavailable"
      ],
      "title": "Access State",
      "type": "string"
    },
    "contributors": {
      "items": {
        "$ref": "#/$defs/WorkContributor"
      },
      "maxItems": 200,
      "title": "Contributors",
      "type": "array"
    },
    "entry_type": {
      "anyOf": [
        {
          "enum": [
            "article",
            "inproceedings",
            "book",
            "incollection",
            "phdthesis",
            "mastersthesis",
            "techreport",
            "misc",
            "unpublished",
            "online",
            "preprint"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Type"
    },
    "field_provenance": {
      "items": {
        "$ref": "#/$defs/FieldProvenance"
      },
      "maxItems": 500,
      "title": "Field Provenance",
      "type": "array"
    },
    "full_text_refs": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "maxItems": 20,
      "title": "Full Text Refs",
      "type": "array"
    },
    "identifiers": {
      "$ref": "#/$defs/WorkIdentifiers"
    },
    "merged_into": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "venue": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Venue"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2200,
          "minimum": 1000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Year"
    }
  },
  "required": [
    "title",
    "contributors",
    "year",
    "venue",
    "identifiers",
    "abstract_ref",
    "access_state",
    "full_text_refs",
    "field_provenance",
    "merged_into"
  ],
  "title": "WorkBody",
  "type": "object"
}
