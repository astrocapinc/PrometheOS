{
  "$defs": {
    "CredentialHealth": {
      "additionalProperties": false,
      "description": "A credential as anyone may see it: its reference and whether a value exists. Never the\nvalue, its length or any fragment.",
      "properties": {
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "reference": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "store": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Store",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "present",
        "store"
      ],
      "title": "CredentialHealth",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/provider_secret_delete_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential": {
      "$ref": "#/$defs/CredentialHealth"
    },
    "removed": {
      "title": "Removed",
      "type": "boolean"
    }
  },
  "required": [
    "removed",
    "credential"
  ],
  "title": "ProviderSecretDeleteResult",
  "type": "object"
}
