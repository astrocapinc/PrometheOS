{
  "$id": "https://prometheos.local/contracts/provider_secret_set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The owner stores a credential in the OS credential store. The value is entered in the\nowner's own interface, bound to nothing but the reference, and never returned or logged.",
  "properties": {
    "from_env": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "From Env"
    },
    "reference": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
      "title": "Reference",
      "type": "string"
    }
  },
  "required": [
    "reference"
  ],
  "title": "ProviderSecretSet",
  "type": "object"
}
