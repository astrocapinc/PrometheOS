{
  "$defs": {
    "OpResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "op_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Op Index",
          "type": "integer"
        },
        "rev": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rev"
        }
      },
      "required": [
        "op_index",
        "id",
        "rev"
      ],
      "title": "OpResult",
      "type": "object"
    }
  },
  "$id": "https://prometheos.local/contracts/success_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true,
      "title": "Ok",
      "type": "boolean"
    },
    "project_id": {
      "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "project_seq": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Project Seq",
      "type": "integer"
    },
    "replayed": {
      "title": "Replayed",
      "type": "boolean"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/OpResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "ok",
    "schema_version",
    "project_id",
    "request_id",
    "project_seq",
    "results",
    "replayed"
  ],
  "title": "SuccessResponse",
  "type": "object"
}
