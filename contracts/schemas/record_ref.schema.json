{
  "$id": "https://prometheos.local/contracts/record_ref.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^(?:project|source|version|entry|claim|assessment|correction|person|role|meeting|item|action|paper|anchor|task|job|package|run|execution|work|matrix|extraction)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "rev": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Rev",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "rev"
  ],
  "title": "RecordRef",
  "type": "object"
}
